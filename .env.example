# LNbits Configuration
LNBITS_URL=http://lnbits:5000
LNBITS_WALLET_ID=your_wallet_id_here
LNBITS_ADMIN_KEY=your_admin_key_here
LNBITS_INVOICE_KEY=your_invoice_key_here

# Africa's Talking Configuration
AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_api_key_here

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Session Configuration
SESSION_TIMEOUT=90

# Logging Configuration
LOG_LEVEL=INFO

# Demo UI at /demo (simulator, SMS inbox, faucet). Never enable in production.
DEMO_MODE=false

# Public HTTPS URL of the gateway. Enables Lightning addresses such as
# 221771234567@your-domain. Leave empty to disable.
PUBLIC_URL=

# Country code added to local numbers typed on the keypad (221 = Senegal)
DEFAULT_COUNTRY_CODE=221

# Shared secret for the Africa's Talking callback. Register the callback as
# https://your-domain/ussd/<this value>. Generate: openssl rand -hex 24
USSD_CALLBACK_SECRET=

# LNbits calls WEBHOOK_BASE_URL/webhooks/lnbits/<WEBHOOK_SECRET> when an
# invoice is paid, so the owner gets an SMS. Generate: openssl rand -hex 24
WEBHOOK_BASE_URL=http://gateway:8000
WEBHOOK_SECRET=

# Let unknown phone numbers create a wallet over USSD
ALLOW_REGISTRATION=true

# Optional SMS sender id and the shortcode mentioned in SMS
AT_SENDER_ID=
USSD_CODE=*384*96#
